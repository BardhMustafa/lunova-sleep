# Database — Supabase (Postgres)
# From Supabase: Project → Settings → Database → "Connection string".
# Use the POOLED string (Transaction mode, port 6543) for DATABASE_URL,
# and the DIRECT string (port 5432) for DIRECT_URL.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Admin dashboard login
ADMIN_PASSWORD="lunova-admin"

# Secret used to sign the admin session cookie (change this!)
SESSION_SECRET="change-me-to-a-long-random-string"

# Where order notifications are conceptually sent (shown in admin)
STORE_CONTACT_EMAIL="orders@lunovasleep.com"
